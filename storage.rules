rules_version = '2';

// Firebase Storage security rules (TM-166 avatars, TM-392 event images, TM-1127 chat media).
//
// The web app uploads a user's avatar image to `avatars/{uid}` and then sets the Firebase user's
// `photoURL` to the resulting download URL (the single source of truth). These rules are the real
// authority for who may write what; the client mirrors them only for a fast, friendly pre-check.
//
// Event images (TM-392) ride the same pattern: the admin console uploads `event-images/{eventId}`
// directly to Storage, then persists the object path on the event row via the admin API
// (`PATCH /api/v1/admin/events/{id}`). Writes are gated on the `role` custom claim the backend
// maintains on the Firebase token (RoleService, TM-110) — admins only.
//
// Enforced on write:
//   - OWNER ONLY  — request.auth.uid must equal the {uid} path segment, so a user can only write
//                   (or overwrite/delete) their OWN avatar object.
//   - IMAGE ONLY  — the uploaded content-type must be image/*.
//   - SIZE CAP    — at most 5 MB (must match MAX_AVATAR_BYTES in web/src/assets/storage.js).
//
// Read: avatars are public-readable. `photoURL` is a non-secret display image rendered in the app
// (and potentially surfaced to other users), and Firebase download URLs already carry an unguessable
// token, so a public read here is appropriate and avoids minting per-view signed URLs.
//
// Everything else under the bucket is denied by default (no catch-all allow).
//
// Deployed to prod by the HITL TM-184 (which also enables Firebase Storage on the project); tested
// here against the Storage emulator (web/e2e).
service firebase.storage {
  match /b/{bucket}/o {

    // Raster-image content types allowed for PUBLICLY-READABLE uploads (TM-722). We deliberately do NOT
    // accept `image/svg+xml`: an SVG is an active document (it can carry inline <script>/onload), so a
    // public-read SVG served from the storage origin is a stored-XSS vector. Every public upload path
    // here (avatars, event-images, venue-images) is world-readable, so all restrict to raster formats.
    function isPublicRasterImage() {
      return request.resource.contentType.matches('image/(png|jpeg|jpg|gif|webp|avif|heic|heif)');
    }

    // Audio content types for chat voice notes (TM-1127). Consistent with isPublicRasterImage: an
    // explicit allow-list of inert media formats (no active/document types). These bound what the
    // backend accepts when it mints a chat-media signed URL (task B); the storage.rules block below
    // still DENIES all direct client access, so this helper documents the intended envelope rather
    // than gating a client write path.
    function isChatAudio() {
      return request.resource.contentType.matches('audio/(mpeg|mp4|aac|ogg|webm|wav|x-m4a|m4a)');
    }

    match /avatars/{uid} {
      // Anyone may read an avatar (public, non-secret display image).
      allow read: if true;

      // Only the authenticated owner may upload/replace their own avatar, and only an image
      // content-type no larger than 5 MB. `request.resource` is the incoming object (create/update).
      allow create, update: if request.auth != null
                            && request.auth.uid == uid
                            && request.resource.size < 5 * 1024 * 1024
                            && isPublicRasterImage();

      // The owner may also delete their own avatar (used by the re-upload cleanup path). A delete has
      // no `request.resource`, so it carries only the owner check — not the size/content-type checks.
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    match /event-images/{eventId} {
      // Anyone may read an event image — the event listing renders it for signed-out visitors too,
      // and download URLs already carry an unguessable token (same reasoning as avatars).
      allow read: if true;

      // Only an ADMIN (the `role` custom claim written by RoleService, TM-110) may upload/replace
      // an event image, and only an image content-type no larger than 5 MB — the avatar caps.
      allow create, update: if request.auth != null
                            && request.auth.token.role == 'ADMIN'
                            && request.resource.size < 5 * 1024 * 1024
                            && isPublicRasterImage();

      // Admins may also delete an event image (re-upload cleanup / event retired). No
      // `request.resource` on delete, so only the role check applies.
      allow delete: if request.auth != null && request.auth.token.role == 'ADMIN';
    }

    match /venue-images/{venueId} {
      // Venue photos (TM-519) ride the same pattern as event images: publicly readable (an event
      // detail may render its venue's photo for signed-out visitors, and the download URL carries an
      // unguessable token), admin-only write, image content-type under 5 MB.
      allow read: if true;

      allow create, update: if request.auth != null
                            && request.auth.token.role == 'ADMIN'
                            && request.resource.size < 5 * 1024 * 1024
                            && isPublicRasterImage();

      // Admins may delete a venue photo (re-upload cleanup / venue retired).
      allow delete: if request.auth != null && request.auth.token.role == 'ADMIN';
    }

    match /city-images/{cityId} {
      // City images (TM-1166) ride the same pattern as event/venue images: publicly readable (the Home
      // empty-state renders a city's big image, and the download URL carries an unguessable token),
      // admin-only write, image content-type under 5 MB.
      allow read: if true;

      allow create, update: if request.auth != null
                            && request.auth.token.role == 'ADMIN'
                            && request.resource.size < 5 * 1024 * 1024
                            && isPublicRasterImage();

      // Admins may delete a city image (re-upload cleanup / city retired).
      allow delete: if request.auth != null && request.auth.token.role == 'ADMIN';
    }

    match /city-icon-images/{cityId} {
      // City ICON images (TM-1166) — the small glyph shown beside a city name, the twin of the big
      // empty-state city-images path. Same envelope: publicly readable display asset, admin-only write,
      // raster image under 5 MB.
      allow read: if true;

      allow create, update: if request.auth != null
                            && request.auth.token.role == 'ADMIN'
                            && request.resource.size < 5 * 1024 * 1024
                            && isPublicRasterImage();

      // Admins may delete a city icon image (re-upload cleanup / city retired).
      allow delete: if request.auth != null && request.auth.token.role == 'ADMIN';
    }

    // Chat media — images and voice notes attached to a conversation (TM-1127, epic TM-468).
    //
    // UNLIKE avatars/event/venue images (which are world-readable display assets), a chat attachment
    // is PRIVATE to its conversation. It is uploaded AND served ONLY through a backend-minted signed
    // URL (task B): the backend authorises the caller against conversation membership, then hands out
    // a short-lived signed URL scoped to the single object. Signed URLs bypass Storage security rules
    // entirely, so this block does NOT need to grant any access for the real flow to work — and it
    // MUST NOT, or it would let any (or every) client read/plant conversation media directly.
    //
    // Therefore every direct client operation is DENIED. A public read would leak private
    // conversation media off an origin whose object names are guessable; a direct client write would
    // let a caller plant bytes outside the backend's membership check + content-type/size envelope
    // (isPublicRasterImage / isChatAudio above — the formats the signed-URL minter accepts). All of
    // that is enforced by the backend, not here.
    match /chat-media/{conversationId}/{imageId} {
      // No public or authenticated direct access — everything goes through the backend signed URL.
      allow read: if false;
      allow write: if false;
    }
  }
}
